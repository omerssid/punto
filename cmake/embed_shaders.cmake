# Turns the files in shaders/ into a C++ translation unit of raw string
# literals, so the built viewer is a single binary with nothing to install
# alongside it. ShaderLibrary still prefers an on-disk copy when one is
# present, which is what makes live reload work during development.
function(punto_embed_shaders OUTPUT_FILE SHADER_DIR)
  file(GLOB SHADER_FILES
       "${SHADER_DIR}/*.glsl" "${SHADER_DIR}/*.vert"
       "${SHADER_DIR}/*.frag" "${SHADER_DIR}/*.comp")
  list(SORT SHADER_FILES)

  set(GENERATED "// Generated by cmake/embed_shaders.cmake -- do not edit.\n")
  string(APPEND GENERATED "#include \"gpu/shader.hpp\"\n\n")
  string(APPEND GENERATED "namespace punto {\nnamespace {\n\n")
  string(APPEND GENERATED "struct EmbeddedShaderRegistrar {\n")
  string(APPEND GENERATED "  EmbeddedShaderRegistrar() {\n")
  string(APPEND GENERATED "    ShaderLibrary& lib = ShaderLibrary::instance();\n")

  foreach(SHADER ${SHADER_FILES})
    get_filename_component(NAME "${SHADER}" NAME)
    file(READ "${SHADER}" CONTENT)
    # A delimiter unlikely to appear inside GLSL, so the raw literal is safe.
    string(APPEND GENERATED
           "    lib.registerBuiltin(\"${NAME}\", R\"PUNTOSHADER(${CONTENT})PUNTOSHADER\");\n")
  endforeach()

  string(APPEND GENERATED "  }\n};\n\n")
  string(APPEND GENERATED "const EmbeddedShaderRegistrar g_registrar;\n\n")
  string(APPEND GENERATED "}  // namespace\n\n")
  # Referenced from main() so the linker cannot drop this object file.
  string(APPEND GENERATED "void ensureEmbeddedShadersLinked() { (void)&g_registrar; }\n\n")
  string(APPEND GENERATED "}  // namespace punto\n")

  # Only rewrite when the content actually changed, so touching an unrelated
  # file does not force a rebuild of everything downstream.
  if(EXISTS "${OUTPUT_FILE}")
    file(READ "${OUTPUT_FILE}" EXISTING)
    if(EXISTING STREQUAL GENERATED)
      return()
    endif()
  endif()
  file(WRITE "${OUTPUT_FILE}" "${GENERATED}")
  message(STATUS "embedded ${SHADER_DIR} -> ${OUTPUT_FILE}")
endfunction()
